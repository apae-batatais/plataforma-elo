# Configure estas variáveis SOMENTE no painel da Netlify (produção), nunca no repositório.
# Sem DATABASE_URL a plataforma roda em modo local, com banco embutido e dados fictícios.
# Nunca coloque valores reais neste arquivo nem no repositório.

# Conexão Postgres do Supabase (modo "transaction pooler")
DATABASE_URL=

# Supabase Auth (login de produção)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
