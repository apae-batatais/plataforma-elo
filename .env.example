# Configure estas variáveis SOMENTE no painel do Render, nunca no repositório.
# Sem DATABASE_URL a plataforma roda localmente, com banco embutido e dados fictícios.
# MODO_DEMONSTRACAO=1 liga o login com usuários fictícios (exige banco marcado como demonstração).
MODO_DEMONSTRACAO=
# Nunca coloque valores reais neste arquivo nem no repositório.

# Conexão Postgres do Supabase (modo "transaction pooler")
DATABASE_URL=

# Supabase Auth (login de produção)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
